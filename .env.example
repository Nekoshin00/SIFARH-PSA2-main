# Copia este archivo a .env y ajusta los valores.
# Solo van aquí los datos sensibles. Las opciones normales (Telegram, Ollama, etc.)
# se configuran en config.json (copia config.example.json a config.json).

# Clave de activación de SIFARH (obligatoria). Se muestra en "Mis descargas" del sitio.
LICENSE_KEY=

# Clave para firmar los JWT. Si se omite, se genera una y se guarda en data/.secret_key
SECRET_KEY=

# Base de datos. Por defecto SQLite local; usa esta variable si conectas a PostgreSQL
# u otro motor con credenciales (por eso va en .env y no en config.json).
DATABASE_URL=sqlite:///./data/farmacia.db

# Telegram (opcional)
TELEGRAM_BOT_TOKEN=
# Solo para modo webhook (ver TELEGRAM_MODE en config.json): se envía como secret_token en setWebhook
TELEGRAM_WEBHOOK_SECRET=
